#!/usr/bin/env python3
"""Run the real merge property, or test its sensitivity with isolated mutants."""
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parents[4]
SYNC_COMMIT = "a140461b570d95ccd385d70d4cce0bbcee22cdfd"
PROPERTY = "test/wire-merge.property.test.ts"
SOURCE = ROOT / "src/wire/merge.ts"
SOURCES = ["src/wire/merge.ts", "src/wire/report.ts", "src/state/project.ts", "src/state/reduce.ts"]
COVERED = [*SOURCES, PROPERTY]


def run(count):
    env = dict(os.environ, WIRE_MERGE_RUNS=str(count))
    env.setdefault("WIRE_MERGE_SEED", "73129")
    started = time.monotonic()
    result = subprocess.run(["bun", "test", PROPERTY, "--timeout", "600000"], cwd=ROOT, env=env, text=True, capture_output=True)
    print(result.stdout + result.stderr)
    print(f"Elapsed: {time.monotonic() - started:.2f}s")
    return result


MUTANTS = [
    ("omit category shape cleanup", "    if (oldBody !== undefined && !isObject(oldBody)) {", "    if (false) {"),
    ("omit AMS shape cleanup", "        if (!isObject(old)) forget(path, observedAt)\n", ""),
    ("omit module subtree cleanup", "const modules: Schema.Json[] = []\n        forget(path, observedAt)", "const modules: Schema.Json[] = []"),
    ("match modules by index", "modules.findIndex((candidate) => isObject(candidate) && candidate.name === item.name)", "0"),
    ("merge module fields", "modules[target] = item", "modules[target] = isObject(modules[target]) && isObject(item) ? { ...modules[target], ...item } : item"),
    ("skip retained-time reindex", "observedAt.set(`${to}${key.slice(from.length)}`, time)", "observedAt.set(key, time)"),
    ("keep AMS units on reset", "delete merged.ams", "void merged.ams"),
    ("stamp the structural AMS container", "        next[key] = merged\n", "        next[key] = merged\n        observedAt.set(path, now)\n"),
    ("store envelope keys", "if (envelopeKeys.has(key)) continue", "if (false) continue"),
]


def interrupted(signum, frame):
    raise KeyboardInterrupt


def lock_path():
    return ROOT / subprocess.run(["git", "rev-parse", "--git-path", "verify-wire-merge.lock"], cwd=ROOT, text=True, capture_output=True, check=True).stdout.strip()


def locked(lock):
    print(f"LOCKED: {lock} exists. A mutants run is active, or one was killed before cleanup.")
    print(f"If no run is active, restore with `cp {lock} src/wire/merge.ts`, check `git diff -- src/wire/merge.ts`, then delete the lock.")
    return 1


def mutants():
    # Take the lock before reading merge.ts or running the baseline, so no other
    # run's mutation can be read as the original. The lock holds the original
    # bytes, so a run killed before cleanup leaves what is needed to restore it.
    lock = lock_path()
    try:
        descriptor = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
    except FileExistsError:
        return locked(lock)
    original = SOURCE.read_bytes()
    with os.fdopen(descriptor, "wb") as saved:
        saved.write(original)
    # A pre-existing failure is never evidence that a mutation was detected.
    if run(300).returncode:
        lock.unlink()
        print("REFUSED: baseline check is red at 300 cases; no mutants were applied or credited. Fix or separately validate the baseline first.")
        return 1
    failures = 0
    signal.signal(signal.SIGTERM, interrupted)
    try:
        for label, before, after in MUTANTS:
            text = original.decode()
            if text.count(before) != 1:
                print(f"ANCHOR MISSING: {label}")
                failures += 1
                continue
            try:
                SOURCE.write_text(text.replace(before, after))
                result = run(300)
                caught = result.returncode != 0 and "Counterexample:" in result.stdout + result.stderr
                print(f"{'caught' if caught else 'MISSED / BROKEN RUN'}: {label}")
                failures += not caught
            finally:
                SOURCE.write_bytes(original)
    finally:
        SOURCE.write_bytes(original)
        lock.unlink()
    return int(bool(failures))


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else "check"
    if command == "drift":
        subprocess.run(["git", "merge-base", "--is-ancestor", SYNC_COMMIT, "HEAD"], cwd=ROOT, check=True)
        status = subprocess.run(["git", "status", "--short", "--", *COVERED], cwd=ROOT, text=True, capture_output=True, check=True)
        if status.stdout:
            print("Uncommitted changes in covered files; commit or revert them, then rerun drift:")
            print(status.stdout, end="")
            return 1
        # Compare content, not history: merged branch commits that a squash
        # replaced are not drift when the covered source is unchanged.
        if subprocess.run(["git", "diff", "--quiet", SYNC_COMMIT, "HEAD", "--", *SOURCES], cwd=ROOT).returncode == 0:
            print(f"No covered source changes since {SYNC_COMMIT}.")
            return 0
        print(f"Covered source changed since {SYNC_COMMIT}; recheck the verification before moving the sync commit:")
        subprocess.run(["git", "diff", "--stat", SYNC_COMMIT, "HEAD", "--", *SOURCES], cwd=ROOT)
        subprocess.run(["git", "log", "--oneline", f"{SYNC_COMMIT}..HEAD", "--", *SOURCES], cwd=ROOT)
        return 1
    version = json.loads((ROOT / "node_modules/fast-check/package.json").read_text())["version"]
    if version != "4.10.2":
        raise SystemExit(f"Expected fast-check 4.10.2, got {version}; run bun install --frozen-lockfile")
    if command in ("check", "deep") and lock_path().exists():
        return locked(lock_path())
    if command == "check":
        return run(300).returncode
    if command == "deep":
        return run(20000).returncode
    if command == "mutants":
        return mutants()
    raise SystemExit("Usage: verify-wire-merge [check|deep|mutants|drift]")


if __name__ == "__main__":
    sys.exit(main())
